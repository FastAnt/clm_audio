# Set SAMSONE_CLM_DATA in your shell before running commands. uv does not load
# this file automatically; use `set -a; source .env; set +a` when needed.
SAMSONE_CLM_DATA=/srv/data/samsone_clm
UV_CACHE_DIR=/srv/data/samsone_clm/cache/uv
HF_HOME=/srv/data/samsone_clm/cache/huggingface
TORCH_HOME=/srv/data/samsone_clm/cache/torch
TMPDIR=/srv/data/samsone_clm/tmp
TOKENIZERS_PARALLELISM=false
